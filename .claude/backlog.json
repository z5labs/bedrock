{
  "select": {
    "label": "story",
    "milestone": null,
    "limit": 200
  },
  "dependencies": {
    "style": "native"
  },
  "verify": [
    "golangci-lint run",
    "cd fit && golangci-lint run",
    "cd circuit && golangci-lint run",
    "cd retry && golangci-lint run",
    "cd host && golangci-lint run",
    "cd pki && golangci-lint run",
    "go build ./...",
    "go -C fit build ./...",
    "go -C circuit build ./...",
    "go -C retry build ./...",
    "go -C host build ./...",
    "go -C pki build ./...",
    "go test -race -cover ./...",
    "go -C fit test -race -cover ./...",
    "go -C circuit test -race -cover ./...",
    "go -C retry test -race -cover ./...",
    "go -C host test -race -cover ./...",
    "go -C pki test -race -cover ./...",
    "go -C host test -race -tags conformance -run '^TestConformance_' ./...",
    "go -C pki test -race -tags interop -run '^TestInterop_' ./..."
  ],
  "merge": {
    "label": "auto-merge",
    "workflow": "auto-merge.yaml"
  },
  "review": {
    "reviewers": ["copilot", "local"],
    "app": {
      "idEnv": "Z5LABS_REVIEW_APP_ID",
      "keyEnv": "Z5LABS_REVIEW_APP_KEY"
    }
  },
  "worktreeDir": ".claude/worktrees"
}
